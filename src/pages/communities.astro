---
import Base from "../layouts/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import JoinStatusNotice from "../components/communities/JoinStatusNotice.astro";
import CommunityCard from "../components/communities/CommunityCard.astro";
import { getLiveCollection } from "astro:content";
import { actions } from "astro:actions";
import { getMembership } from "../lib/opensocial/membership";
import { resolveHandleToDid } from "../lib/community/identity";
import { getCommunityActionErrorCopy } from "../lib/community/action-error-copy";

const communitiesResult = await getLiveCollection("communities");
const communities = communitiesResult.entries?.map((entry) => entry.data) ?? [];

const joinResult = Astro.getActionResult(actions.joinOpenSocialCommunity);
const leaveResult = Astro.getActionResult(actions.leaveOpenSocialCommunity);

const outcomeResult = joinResult?.data?.outcome || joinResult?.error ? joinResult : leaveResult;
const joinOutcome = outcomeResult?.data?.outcome ?? null;
const joinError = getCommunityActionErrorCopy(outcomeResult?.error, "join");
const statusHandle = outcomeResult?.data?.community?.trim();
const statusCommunity = statusHandle
  ? communities.find((c) => c.handle === statusHandle)
  : undefined;

const loggedInUser = Astro.locals.loggedInUser;

// Resolve which opensocial communities the signed-in viewer already belongs to,
// so members see a "Joined" badge instead of a redundant Join button. Only
// opensocial communities are probed (others have no join endpoint), and each
// lookup is isolated: a failed probe just falls back to showing Join.
const memberHandles = new Set<string>();
const adminHandles = new Set<string>();
if (loggedInUser) {
  const openSocial = communities.filter((c) => c.isOpenSocialCommunity);
  const results = await Promise.allSettled(
    openSocial.map(async (c) => {
      const communityDid = await resolveHandleToDid(c.handle);
      const membership = await getMembership({
        communityDid,
        userDid: loggedInUser.did,
      });
      return {
        handle: c.handle,
        isMember: membership.isMember,
        isAdmin: membership.isAdmin,
      };
    }),
  );
  for (const result of results) {
    if (result.status !== "fulfilled") continue;
    if (result.value.isMember) memberHandles.add(result.value.handle);
    if (result.value.isAdmin) adminHandles.add(result.value.handle);
  }
}

const REGION_ORDER = ["North America — USA", "North America — Canada", "South America", "Europe", "Online", "Other"];
const grouped = new Map<string, typeof communities>();
for (const community of communities) {
  const region = community.region ?? "Other";
  if (!grouped.has(region)) grouped.set(region, []);
  grouped.get(region)!.push(community);
}
const regionRank = (r: string) => {
  const i = REGION_ORDER.indexOf(r);
  return i === -1 ? REGION_ORDER.length : i;
};
const regions = [...grouped.keys()].sort(
  (a, b) => regionRank(a) - regionRank(b) || a.localeCompare(b),
);
---

<Base title="Communities" description="Find AT Protocol communities around the world.">
  <Header slot="header" />

  <section class="communities-page section">
    <div class="container">
      <h1>Communities</h1>
      <p class="communities-sub">
        AT Protocol communities around the world. Each group is run independently by local organizers.
        Find one near you or <a href="https://bsky.app/profile/ngerakines.me" rel="noopener noreferrer" target="_blank">start your own</a>.
      </p>

      <JoinStatusNotice
        outcome={joinOutcome}
        error={joinError}
        communityName={statusCommunity?.name}
      />

      {regions.map((region) => (
        <section class="region-group">
          <h2 class="region-heading">{region}</h2>
          <div class="communities-grid">
            {grouped.get(region)!.map(c => (
              <div class="community-entry">
                <div class="community-entry__primary">
                  <CommunityCard {...c} />
                  {c.isOpenSocialCommunity && (
                    !loggedInUser ? (
                      <button class="join-btn" type="button" data-open-auth>
                        Log in to join
                      </button>
                    ) : adminHandles.has(c.handle) ? (
                      <span class="join-badge" aria-label={`You're an admin of ${c.name}`}>
                        ★ Admin
                      </span>
                    ) : memberHandles.has(c.handle) ? (
                      <form method="POST" action={actions.leaveOpenSocialCommunity}>
                        <input type="hidden" name="handle" value={c.handle} />
                        <button class="join-btn join-btn--ghost" type="submit">Leave</button>
                      </form>
                    ) : (
                      <form method="POST" action={actions.joinOpenSocialCommunity}>
                        <input type="hidden" name="handle" value={c.handle} />
                        <button class="join-btn" type="submit">Join</button>
                      </form>
                    )
                  )}
                  {c.description && <p class="community-desc">{c.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-open-auth]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const menu = document.querySelector<HTMLDetailsElement>('details.auth-menu');
      if (!menu) return;
      menu.open = true;
      menu.scrollIntoView({ behavior: 'smooth', block: 'start' });
      menu.querySelector<HTMLInputElement>('input[name="atproto-id"]')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .communities-page h1 {
    margin-bottom: var(--space-sm);
  }

  .communities-sub {
    color: var(--foreground-secondary);
    font-size: var(--text-sm);
    max-width: 55ch;
    line-height: var(--leading-relaxed);
  }

  .region-group {
    margin-top: var(--space-xl);
  }

  .region-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--foreground-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-base);
  }

  .communities-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .community-entry {
    display: block;
    align-items: center;
    gap: var(--space-base) var(--space-lg);
  }

  .community-entry__primary {
    display: flex;
    align-items: center;
    gap: var(--space-base);
    flex-wrap: wrap;
    min-width: 0;
  }

  .community-desc {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
  }

  .join-btn {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: var(--space-xs) var(--space-md);
    background: var(--primary);
    color: var(--primary-foreground);
    border: 0;
    border-radius: var(--radius-pill);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .join-btn:hover {
    background: var(--primary-hover);
  }
  .join-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .join-btn--ghost {
    background: transparent;
    color: var(--primary);
    border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--border));
  }
  .join-btn--ghost:hover {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }

  .join-badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--border));
    color: var(--primary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

</style>
