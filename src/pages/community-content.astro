---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PostCard from '../components/content/PostCard.astro';
import ShareableContent from '../components/content/ShareableContent.astro';
import Combobox from '../components/auth/Combobox.astro';
import AtprotoIcon from '../components/auth/icons/AtprotoIcon.astro';
import JoinStatusNotice from '../components/communities/JoinStatusNotice.astro';
import { getLiveCollection } from 'astro:content';
import { actions } from 'astro:actions';
import { getBlueskyAgent } from '@fujocoded/authproto/helpers';
import { getMembership } from '../lib/opensocial/membership';
import { getAtmosphereCommunityDid } from '../lib/community/atmosphere';
import { getShareCandidates } from '../lib/community/share-candidates';

const joinResult = Astro.getActionResult(actions.joinAtmosphereCommunity);
const leaveResult = Astro.getActionResult(actions.leaveAtmosphereCommunity);

const shareResult = Astro.getActionResult(actions.shareAtmosphereContent);
if (shareResult?.data?.redirectUrl) {
  return Astro.redirect(shareResult.data.redirectUrl, 303);
}
if (shareResult?.error) {
  return Astro.redirect('/community-content?share=error', 303);
}

const feedResult = await getLiveCollection('feed');
const mergedPosts = (feedResult.entries ?? [])
  .map((entry) => entry.data)
  .sort((a, b) => (b.publishedAt ?? b.sharedAt).getTime() - (a.publishedAt ?? a.sharedAt).getTime());

const loggedInUser = Astro.locals.loggedInUser;

// Resolve membership for the signed-in viewer so we can swap the join CTA out
// once they're in. Failures here shouldn't take down the page — treat them as
// "unknown" and fall back to showing the join button.
let isMember = false;
let isAdmin = false;
if (loggedInUser) {
  try {
    const communityDid = await getAtmosphereCommunityDid();
    const membership = await getMembership({
      communityDid,
      userDid: loggedInUser.did,
    });
    isMember = membership.isMember;
    isAdmin = membership.isAdmin;
  } catch (err) {
    console.warn('[community-content] membership lookup failed', err);
  }
}

const isKnownCommunityParticipant = isMember || isAdmin;
const rawJoinStatus =
  joinResult?.data?.status ??
  (joinResult?.error ? 'error' : null) ??
  leaveResult?.data?.status ??
  (leaveResult?.error ? 'error' : null);
const joinStatus = rawJoinStatus &&
  !(isKnownCommunityParticipant && rawJoinStatus === 'error')
  ? rawJoinStatus
  : null;

type ShareStatusKey =
  | 'ok'
  | 'invalid'
  | 'error'
  | 'signin'
  | 'permission'
  | 'not-member';
const SHARE_STATUS_COPY: Record<ShareStatusKey, { tone: 'success' | 'info' | 'error'; message: string }> = {
  ok: { tone: 'success', message: 'Shared with the community.' },
  invalid: { tone: 'error', message: "That item couldn't be shared. Pick another one and try again." },
  error: { tone: 'error', message: "Something went wrong while sharing. Try again later." },
  signin: { tone: 'error', message: 'Sign in first, then try sharing again.' },
  permission: { tone: 'error', message: 'Your login needs community content permission. Log out and back in, then try again.' },
  'not-member': { tone: 'error', message: 'Join the community before sharing content.' },
};

const shareParam = Astro.url.searchParams.get('share');
const shareStatus =
  shareParam && shareParam in SHARE_STATUS_COPY
    ? SHARE_STATUS_COPY[shareParam as ShareStatusKey]
    : null;

const sourceParam = Astro.url.searchParams.get('source')?.trim();
const shareRepo = sourceParam || loggedInUser?.handle || '';
let shareSourceProfile: { displayName?: string; avatar?: string } | null = null;
let shareCandidates: Awaited<ReturnType<typeof getShareCandidates>> | null = null;
let shareCandidatesError = false;
const canShareContent = isKnownCommunityParticipant;
if (shareRepo && canShareContent) {
  try {
    const agent = await getBlueskyAgent();
    const [profileResult, candidatesResult] = await Promise.allSettled([
      agent?.app.bsky.actor.getProfile({ actor: shareRepo }),
      getShareCandidates(shareRepo),
    ]);
    if (profileResult.status === 'fulfilled') {
      shareSourceProfile = {
        displayName: profileResult.value?.data.displayName,
        avatar: profileResult.value?.data.avatar,
      };
    }
    if (candidatesResult.status === 'fulfilled') {
      shareCandidates = candidatesResult.value;
    } else {
      shareCandidatesError = true;
      console.warn('[community-content] share candidate lookup failed', candidatesResult.reason);
    }
  } catch (err) {
    shareCandidatesError = true;
    console.warn('[community-content] share candidate lookup failed', err);
  }
}

---

<Base title="Community Content" description="Blog posts and articles from across the AT Protocol community.">
  <Header slot="header" />

  <section class="content-page section">
    <div class="container">
      <h1>Community content</h1>
      <p class="content-sub">
        Blog posts and articles shared by community members across the Atmosphere.
        Content is aggregated from the atmosphere.community <a
          href="https://blog.atmosphere.community"
          rel="noopener noreferrer"
          target="_blank">Offprint</a
        >
        and community accounts via <a
          href="https://opensocial.community"
          rel="noopener noreferrer"
          target="_blank">OpenSocial</a
        >.
      </p>

      <JoinStatusNotice status={joinStatus} />
      {shareStatus && (
        <p class={`share-status share-status--${shareStatus.tone}`} role="status">
          {shareStatus.message}
        </p>
      )}

      {!loggedInUser ? (
        <aside class="share-cta" aria-label="Share your content">
          <div class="share-cta__text">
            <p class="share-cta__title">Want to share yours?</p>
            <p class="share-cta__sub">
              Log into the Atmosphere, join the community, and share your content!
            </p>
          </div>
          <button class="share-cta__button" type="button" data-open-auth>
            Log in & join the community
          </button>
        </aside>
      ) : canShareContent ? (
        <aside class="share-cta share-cta--member share-cta--picker" aria-label="Share with the community">
          <div class="share-cta__main">
            <div class="share-cta__text">
              <p class="share-cta__title">Share with the community</p>
              <div class="share-source">
                <details class="share-source__menu">
                  <summary class="share-source__summary">
                    <span>Choose an event or Standard Site document from</span>
                    <span class="share-source__chip">
                      {shareSourceProfile?.avatar ? (
                        <img
                          class="share-source__avatar"
                          src={shareSourceProfile.avatar}
                          alt=""
                          width="26"
                          height="26"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="share-source__avatar share-source__avatar--fallback" aria-hidden="true">
                          {(shareSourceProfile?.displayName || shareRepo || '@').charAt(0).toUpperCase()}
                        </span>
                      )}
                      <span class="share-source__identity">
                        <span class="share-source__name">
                          {shareSourceProfile?.displayName?.trim() || shareRepo}
                        </span>
                        <span class="share-source__handle">@{shareRepo}</span>
                      </span>
                    </span>
                  </summary>
                  <form class="share-source__form" method="GET" action="/community-content">
                    <Combobox
                      id="share-source-handle"
                      name="source"
                      label="Content source"
                      placeholder="handle.bsky.social"
                      inputClass="share-source__input"
                      autocomplete="off"
                      inputmode="url"
                    >
                      <AtprotoIcon slot="leading-icon" width={18} height={18} />
                    </Combobox>
                    <button class="share-source__button" type="submit">Use source</button>
                  </form>
                </details>
                {isAdmin && (
                  <p class="share-source__note">Admins can't leave the community from here.</p>
                )}
              </div>
            </div>

            <ShareableContent
              candidates={shareCandidates}
              repo={shareRepo}
              error={shareCandidatesError}
            />
          </div>
          {!isAdmin && (
            <form method="POST" action={actions.leaveAtmosphereCommunity}>
              <button class="share-cta__button share-cta__button--ghost" type="submit">
                Leave the community
              </button>
            </form>
          )}
        </aside>
      ) : (
        <aside class="share-cta" aria-label="Join the community">
          <div class="share-cta__text">
            <p class="share-cta__title">Want to share yours?</p>
            <p class="share-cta__sub">
              Join atmosphere.community — your posts can show up here too.
            </p>
          </div>
          <form method="POST" action={actions.joinAtmosphereCommunity}>
            <button class="share-cta__button" type="submit">
              Join the community
            </button>
          </form>
        </aside>
      )}

      {mergedPosts.length > 0 ? (
        <div class="posts-list">
          {mergedPosts.map((post) => <PostCard {...post} />)}
        </div>
      ) : (
        <div class="content-empty">
          <p>
            No community content yet. <a href="https://blog.atmosphere.community">Visit the
              blog</a
            > or share content via your community account.
          </p>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  type Actor = {
    handle: string;
    displayName?: string;
    avatar?: string;
  };
  type Suggestion = {
    value: string;
    label?: string;
    sublabel?: string;
    avatar?: string;
  };

  const SEARCH_ACTORS_URL =
    "https://public.api.bsky.app/xrpc/app.bsky.actor.searchActorsTypeahead";

  const searchBskyActors = async (q: string): Promise<Suggestion[]> => {
    const url = new URL(SEARCH_ACTORS_URL);
    url.searchParams.set("q", q);
    url.searchParams.set("limit", "8");
    const res = await fetch(url, { headers: { accept: "application/json" } });
    if (!res.ok) return [];
    const data = (await res.json()) as { actors?: Actor[] };
    return (data.actors ?? []).map((a) => ({
      value: a.handle,
      label: a.displayName || a.handle,
      sublabel: `@${a.handle}`,
      avatar: a.avatar,
    }));
  };

  const sourceInput = document.getElementById(
    "share-source-handle",
  ) as HTMLInputElement | null;
  const sourceCombobox = sourceInput?.closest("cmb-combobox");
  sourceCombobox?.addEventListener("combobox-search", (e) => {
    const detail = (e as CustomEvent<{ query: string; results: Promise<Suggestion[]> | null }>)
      .detail;
    detail.results = searchBskyActors(detail.query);
  });
  sourceCombobox?.addEventListener("autocomplete-select", () => {
    sourceInput?.form?.requestSubmit();
  });

  document.querySelectorAll<HTMLElement>('[data-open-auth]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const menu = document.querySelector<HTMLDetailsElement>('details.auth-menu');
      if (!menu) return;
      menu.open = true;
      menu.scrollIntoView({ behavior: 'smooth', block: 'start' });
      menu.querySelector<HTMLInputElement>('input[name="atproto-id"]')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .content-page h1 {
    margin-bottom: var(--space-sm);
  }

  .content-sub {
    color: var(--foreground-secondary);
    font-size: var(--text-sm);
    max-width: 55ch;
    line-height: var(--leading-relaxed);
  }

  .share-status {
    margin-top: var(--space-base);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .share-status--success {
    background: var(--success-muted, var(--primary-muted));
    color: var(--success, var(--primary));
  }

  .share-status--info {
    background: var(--muted);
    color: var(--foreground-secondary);
  }

  .share-status--error {
    background: var(--error-muted, var(--muted));
    color: var(--error, var(--foreground));
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .content-empty {
    margin-top: var(--space-xl);
    padding: var(--space-2xl);
    text-align: center;
    color: var(--foreground-secondary);
    background: var(--muted);
    border-radius: var(--radius-md);
  }

  .share-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
    padding: var(--space-lg) var(--space-xl);
    background: var(--primary-muted);
    border: 1px solid var(--primary-muted);
    border-radius: var(--radius-md);
  }

  .share-cta__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .share-cta__main {
    display: grid;
    gap: var(--space-md);
    min-width: min(100%, 32rem);
    flex: 1 1 32rem;
  }

  .share-cta__title {
    margin: 0;
    color: var(--primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .share-cta__sub {
    margin: 0;
    color: var(--foreground-secondary);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .share-source {
    display: grid;
    gap: var(--space-xs);
  }

  .share-source__menu {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .share-source__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    max-width: 100%;
    color: var(--foreground-secondary);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    list-style: none;
    cursor: pointer;
  }

  .share-source__summary::-webkit-details-marker {
    display: none;
  }

  .share-source__summary:focus-visible,
  .share-source__button:focus-visible,
  :global(.share-source__input:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .share-source__chip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
    max-width: min(100%, 18rem);
    min-height: 34px;
    border: 1px solid color-mix(in oklch, var(--primary) 30%, var(--border));
    border-radius: var(--radius-pill);
    padding: 3px var(--space-md) 3px 3px;
    background:
      linear-gradient(
        135deg,
        color-mix(in oklch, var(--primary) 10%, var(--card)),
        var(--card) 65%
      );
    color: var(--primary);
    line-height: 1;
    box-shadow: 0 1px 0 color-mix(in oklch, var(--primary) 12%, transparent);
  }

  .share-source__summary:hover .share-source__chip,
  .share-source__menu[open] .share-source__chip {
    background: var(--card);
    border-color: var(--primary);
  }

  .share-source__avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--primary-muted);
    box-shadow: 0 0 0 2px var(--card);
  }

  .share-source__avatar--fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .share-source__identity {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .share-source__name,
  .share-source__handle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .share-source__name {
    color: var(--foreground);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.1;
  }

  .share-source__handle {
    color: var(--foreground-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
  }

  .share-source__form {
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 0;
    z-index: var(--z-popover);
    display: grid;
    gap: var(--space-sm);
    width: min(21rem, calc(100vw - 2 * var(--space-lg)));
    padding: var(--space-base);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--elevation-high);
  }

  :global(.share-source__input) {
    width: 100%;
    min-height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-sm);
  }

  .share-source__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border: 0;
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-base);
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .share-source__button:hover {
    background: var(--primary-hover);
  }

  .share-source__note {
    margin: 0;
    color: var(--foreground-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .share-cta__button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-sm) var(--space-lg);
    background: var(--primary);
    color: var(--primary-foreground);
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .share-cta__button:hover {
    background: var(--primary-hover);
  }

  .share-cta__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .share-cta__button:disabled:hover {
    background: var(--primary);
  }

  .share-cta__button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .share-cta__button--ghost {
    background: transparent;
    color: var(--primary);
    border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--border));
  }
  .share-cta__button--ghost:hover {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }

  @media (max-width: 640px) {
    .share-cta--picker {
      align-items: stretch;
    }

    .share-source__summary {
      align-items: flex-start;
      flex-direction: column;
    }

    .share-source__form {
      width: min(100vw - 2 * var(--space-lg), 21rem);
    }

    .share-cta__button {
      justify-content: center;
      width: 100%;
    }
  }

</style>
