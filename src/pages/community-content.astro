---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PostCard from '../components/content/PostCard.astro';
import JoinStatusNotice from '../components/communities/JoinStatusNotice.astro';
import CommunitySharePanel from '../components/communities/CommunitySharePanel.astro';
import { getLiveCollection } from 'astro:content';
import { actions } from 'astro:actions';
import { dedupeFeedEntries } from '../lib/community/dedup-feed';
import {
  getAtmosphereViewerMembershipState,
  getJoinActionNotice,
} from '../features/community-membership/page';
import { getShareNotice } from '../features/community-sharing/notice';
import { getCommunitySharePanelState } from '../features/community-sharing/page';

const joinResult = Astro.getActionResult(actions.joinAtmosphereCommunity);
const leaveResult = Astro.getActionResult(actions.leaveAtmosphereCommunity);

const shareResult = Astro.getActionResult(actions.shareAtmosphereContent);
const unshareResult = Astro.getActionResult(actions.unshareAtmosphereContent);
const recentlyUnsharedRecordUri = unshareResult?.data?.shareRecordUri ?? null;
const feedResult = await getLiveCollection('feed');
const mergedPosts = dedupeFeedEntries(
  (feedResult.entries ?? []).map((entry) => entry.data),
)
  .filter((entry) => entry.shareRecordUri !== recentlyUnsharedRecordUri)
  .sort((a, b) => (b.publishedAt ?? b.sharedAt).getTime() - (a.publishedAt ?? a.sharedAt).getTime());

const loggedInUser = Astro.locals.loggedInUser;
const { isMember, isAdmin } = await getAtmosphereViewerMembershipState(
  loggedInUser,
);

const isKnownCommunityParticipant = isMember || isAdmin;
const joinNotice = getJoinActionNotice(joinResult, leaveResult);
const shareNotice = getShareNotice(shareResult, unshareResult);

const getUnshareableShareRecordUri = (
  post: (typeof mergedPosts)[number],
): string | null => {
  if (!loggedInUser || !post.shareRecordUri) return null;
  return post.sharedBy?.did === loggedInUser.did || isAdmin
    ? post.shareRecordUri
    : null;
};

const canShareContent = isKnownCommunityParticipant;
const {
  shareRepo,
  shareSourceProfile,
  shareCandidates,
  shareCandidatesError,
} = await getCommunitySharePanelState({
  sourceParam: Astro.url.searchParams.get('source'),
  fallbackRepo: loggedInUser?.handle,
  canShareContent,
});

---

<Base title="Community Content" description="Blog posts and articles from across the AT Protocol community.">
  <Header slot="header" />

  <section class="content-page section">
    <div class="container">
      <h1>Community content</h1>
      <p class="content-sub">
        Blog posts and articles shared by community members across the Atmosphere.
        Content is aggregated from the atmosphere.community <a
          href="https://blog.atmosphere.community"
          rel="noopener noreferrer"
          target="_blank">Offprint</a
        >
        and community accounts via <a
          href="https://opensocial.community"
          rel="noopener noreferrer"
          target="_blank">OpenSocial</a
        >.
      </p>

      <JoinStatusNotice notice={joinNotice} />
      {shareNotice && (
        <p class={`share-status share-status--${shareNotice.tone}`} role="status">
          {shareNotice.message}
        </p>
      )}

      <CommunitySharePanel
        loggedInUser={loggedInUser}
        isMember={isMember}
        isAdmin={isAdmin}
        shareRepo={shareRepo}
        shareSourceProfile={shareSourceProfile}
        shareCandidates={shareCandidates}
        shareCandidatesError={shareCandidatesError}
      />

      {mergedPosts.length > 0 ? (
        <div class="posts-list">
          {mergedPosts.map((post) => {
            const shareRecordUri = getUnshareableShareRecordUri(post);
            return (
              <PostCard {...post}>
                {shareRecordUri && (
                  <form
                    slot="actions"
                    class="post-unshare"
                    method="POST"
                    action={actions.unshareAtmosphereContent}
                  >
                    <input type="hidden" name="shareRecordUri" value={shareRecordUri} />
                    <button class="post-unshare__button" type="submit">
                      Unshare
                    </button>
                  </form>
                )}
              </PostCard>
            );
          })}
        </div>
      ) : (
        <div class="content-empty">
          <p>
            No community content yet. <a href="https://blog.atmosphere.community" rel="noopener noreferrer" target="_blank">Visit the
              blog</a
            > or share content via your community account.
          </p>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .content-page h1 {
    margin-bottom: var(--space-sm);
  }

  .content-sub {
    color: var(--foreground-secondary);
    font-size: var(--text-sm);
    max-width: 55ch;
    line-height: var(--leading-relaxed);
  }

  .share-status {
    margin-top: var(--space-base);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .share-status--success {
    background: var(--success-muted, var(--primary-muted));
    color: var(--success, var(--primary));
  }

  .share-status--info {
    background: var(--muted);
    color: var(--foreground-secondary);
  }

  .share-status--error {
    background: var(--error-muted, var(--muted));
    color: var(--error, var(--foreground));
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .post-unshare {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .post-unshare__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    border: 1px solid color-mix(in oklch, var(--primary) 24%, var(--border));
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    color: var(--primary);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .post-unshare__button:hover {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    border-color: color-mix(in oklch, var(--primary) 40%, var(--border));
  }

  .post-unshare__button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .content-empty {
    margin-top: var(--space-xl);
    padding: var(--space-2xl);
    text-align: center;
    color: var(--foreground-secondary);
    background: var(--muted);
    border-radius: var(--radius-md);
  }
</style>
