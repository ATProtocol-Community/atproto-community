---
type AvatarSource = { url: string } | { initials: string; color: string };

interface Community {
  name: string;
  location: string;
  coordinates?: [number, number] | null;
  avatar: AvatarSource;
  bluesky?: string;
  website?: string;
}

interface Props {
  communities: Community[];
}

const { communities } = Astro.props;
const markersJson = JSON.stringify(
  communities
    .filter((c) => c.coordinates != null)
    .map((c) => ({
      name: c.name,
      location: c.location,
      coordinates: c.coordinates,
      avatar: c.avatar,
      href: c.bluesky ?? c.website ?? null,
      isBluesky: Boolean(c.bluesky),
    }))
);
---

<div id="globe" data-markers={markersJson}></div>

<style>
  #globe {
    width: 100%;
    height: 500px;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  #globe :global(.marker-root) {
    width: 0;
    height: 0;
  }

  #globe :global(.community-marker) {
    position: absolute;
    left: 0;
    top: 0;
    width: max-content;
    display: flex;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-pill);
    padding: 2px;
    box-shadow: var(--elevation-low);
    color: inherit;
    text-decoration: none;
    transform: translate(-17px, -17px);
    transition: padding 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Expand the touch target without growing the visible marker. */
  #globe :global(.community-marker::before) {
    content: "";
    position: absolute;
    inset: -8px;
  }

  #globe :global(.community-marker--link) {
    cursor: pointer;
  }

  #globe :global(.community-marker:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  #globe :global(.community-marker__avatar) {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  #globe :global(.community-marker__avatar--initials) {
    display: flex;
    align-items: center;
    justify-content: center;
    color: oklch(98% 0 0);
    font-size: 8px;
    font-weight: 700;
    font-family: var(--font-body, sans-serif);
    letter-spacing: 0.02em;
  }

  /* Collapsed: zero width, fully clipped. Open: max-width slides the text
     and icon out from behind the avatar. */
  #globe :global(.community-marker__details) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.15s ease;
  }

  #globe :global(.community-marker--open) {
    padding-right: var(--space-md);
    box-shadow: var(--elevation-regular);
  }

  #globe :global(.community-marker--link.community-marker--open) {
    border-color: var(--primary);
  }

  #globe :global(.community-marker--open .community-marker__details) {
    max-width: var(--details-w, 260px);
    opacity: 1;
    transition: max-width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease 0.08s;
  }

  #globe :global(.community-marker__text) {
    display: flex;
    flex-direction: column;
    padding-left: var(--space-sm);
  }

  #globe :global(.community-marker__name) {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--card-foreground);
    line-height: 1.2;
    white-space: nowrap;
  }

  #globe :global(.community-marker__location) {
    font-size: 9px;
    color: var(--foreground-muted);
    line-height: 1.2;
    white-space: nowrap;
  }

  #globe :global(.community-marker__icon) {
    flex-shrink: 0;
    color: var(--primary);
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    #globe :global(.community-marker),
    #globe :global(.community-marker__details) {
      transition: opacity 0.2s;
    }
  }
</style>

<script>
  import "maplibre-gl/dist/maplibre-gl.css";
  import { Map, Marker, setWorkerUrl } from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";

  setWorkerUrl(workerUrl);

  type Avatar = { url: string } | { initials: string; color: string };
  type CommunityMarker = {
    name: string;
    location: string;
    coordinates: [number, number];
    avatar: Avatar;
    href: string | null;
    isBluesky: boolean;
  };

  const globeEl = document.getElementById("globe")!;
  const markers: CommunityMarker[] = JSON.parse(globeEl.dataset.markers ?? "[]");

  const map = new Map({
    container: "globe",
    style: "/mapstyle.json",
    center: [-50, 30],
    zoom: 1.5,
  });

  // Same glyph as icons/BlueskyIcon.astro, inlined for the DOM-built markers.
  const BLUESKY_ICON = `<svg width="16" height="14" viewBox="0 0 568 501" fill="currentColor" aria-hidden="true"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 49.845c0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.907 82.697 153.834-122.178 126.907-175.736-31.784-189.577-72.58-1.786-5.271-2.62-7.721-2.756-5.636-.14-2.085-.97.365-2.757 5.636-13.84 40.796-67.399 199.487-189.577 72.58C22.56 388.152 52.4 321.209 169.7 301.345c-67.106 11.42-142.547-7.45-163.25-81.433C.488 198.634-9.667 67.556-9.667 49.845c0-78.75 76.134-51.456 132.788-16.181z"/></svg>`;

  const ESCAPES: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" };

  function esc(value: string): string {
    return value.replace(/[&<>"]/g, (c) => ESCAPES[c]);
  }

  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // MapLibre dims markers occluded by the globe to opacityWhenCovered (0.2
  // by default) rather than hiding them outright, so a faded marker is on
  // the back and should be treated as invisible.
  function isOccluded(entry: Entry): boolean {
    return parseFloat(entry.outer.style.opacity || "1") < 0.9;
  }

  // ---------------------------------------------------------------------
  // Marker construction & interaction. Hover opens on mouse devices; on
  // touch, the first tap opens and the second follows the link. Only one
  // marker is ever open at a time.
  // ---------------------------------------------------------------------

  type Entry = { lngLat: [number, number]; outer: HTMLElement; pill: HTMLElement };
  const entries: Entry[] = [];
  let openEntry: Entry | null = null;

  function setOpen(entry: Entry, open: boolean) {
    if (open && openEntry && openEntry !== entry) setOpen(openEntry, false);
    openEntry = open ? entry : openEntry === entry ? null : openEntry;
    entry.pill.classList.toggle("community-marker--open", open);
    entry.outer.style.zIndex = open ? "10" : "";
  }

  function buildEntry(community: CommunityMarker): Entry {
    const outer = document.createElement("div");
    outer.className = "marker-root";

    const hasLink = Boolean(community.href);
    const pill = document.createElement(hasLink ? "a" : "div");
    pill.className = hasLink ? "community-marker community-marker--link" : "community-marker";

    if (hasLink) {
      const anchor = pill as HTMLAnchorElement;
      anchor.href = community.href!;
      anchor.target = "_blank";
      anchor.rel = "noopener noreferrer";
      anchor.setAttribute(
        "aria-label",
        `${community.name}${community.isBluesky ? " on Bluesky" : ""}`,
      );
    } else {
      pill.setAttribute("aria-hidden", "true");
    }

    const avatar =
      "url" in community.avatar
        ? `<img class="community-marker__avatar" src="${esc(community.avatar.url)}" alt="" loading="lazy" decoding="async">`
        : `<span class="community-marker__avatar community-marker__avatar--initials" style="background: ${esc(community.avatar.color)}">${esc(community.avatar.initials)}</span>`;

    pill.innerHTML = `
      ${avatar}
      <span class="community-marker__details" aria-hidden="true">
        <span class="community-marker__text">
          <span class="community-marker__name">${esc(community.name)}</span>
          <span class="community-marker__location">${esc(community.location)}</span>
        </span>
        ${community.isBluesky ? `<span class="community-marker__icon">${BLUESKY_ICON}</span>` : ""}
      </span>`;

    outer.append(pill);

    const entry: Entry = {
      lngLat: [community.coordinates[1], community.coordinates[0]],
      outer,
      pill,
    };

    if (canHover) {
      pill.addEventListener("mouseenter", () => setOpen(entry, true));
      pill.addEventListener("mouseleave", () => setOpen(entry, false));
      pill.addEventListener("focus", () => setOpen(entry, true));
      pill.addEventListener("blur", () => setOpen(entry, false));
    } else {
      pill.addEventListener("click", (e) => {
        if (pill.classList.contains("community-marker--open")) return;
        e.preventDefault();
        e.stopPropagation();
        setOpen(entry, true);
      });
    }

    return entry;
  }

  function addMarkers() {
    for (const community of markers) {
      const entry = buildEntry(community);
      entries.push(entry);
      new Marker({ element: entry.outer, anchor: "center" })
        .setLngLat(entry.lngLat)
        .addTo(map);
    }
  }

  // Tapping anywhere else on the map closes the opened marker.
  if (!canHover) map.on("click", () => openEntry && setOpen(openEntry, false));

  map.on("style.load", () => {
    map.setProjection({ type: "globe" });
    addMarkers();
  });

  // ---------------------------------------------------------------------
  // Idle spin: drift the globe east while nothing else is happening,
  // slowing in proportion to zoom until it stops at maxSpinZoom (past
  // that point the whole globe no longer fits on screen, so a lateral
  // drift stops reading as "spinning" and starts reading as "panning").
  // ---------------------------------------------------------------------

  const secondsPerRevolution = 180;
  const maxSpinZoom = 6;

  const RESUME_DELAY_MS = 1000;
  let paused = false;
  let resumeTimer: ReturnType<typeof setTimeout> | undefined;

  function spinGlobe() {
    if (paused) return;

    const zoom = map.getZoom();
    const speed = Math.min(1, (maxSpinZoom - zoom) / maxSpinZoom);
    if (speed <= 0) return;

    const center = map.getCenter();
    center.lng += (360 / secondsPerRevolution) * speed;
    map.easeTo({ center, duration: 1000, easing: (n) => n });
  }

  function pauseSpin() {
    paused = true;
    clearTimeout(resumeTimer);
    resumeTimer = setTimeout(() => {
      paused = false;
      requestAnimationFrame(spinGlobe);
    }, RESUME_DELAY_MS);
  }

  if (!reduceMotion) {
    map.on("moveend", spinGlobe);
    map.on("load", spinGlobe);

    globeEl.addEventListener("pointerdown", pauseSpin);
    map.on("zoomstart", pauseSpin);
    map.on("dragend", pauseSpin);
    map.on("zoomend", pauseSpin);
  }

  // ---------------------------------------------------------------------
  // Ambient auto-hover: while the globe idles, open a random on-screen
  // marker for a second, rest two, then pick another — a rolling tour of
  // the communities as the globe spins. It stands down while the user is
  // interacting (spin paused), has a marker open themselves, or the tab
  // is in the background, and is off under reduced motion like the spin.
  // ---------------------------------------------------------------------

  const AUTO_OPEN_MS = 1000;
  const AUTO_REST_MS = 2000;
  let autoLast: Entry | null = null;

  function autoHoverTick() {
    if (!paused && !openEntry && !document.hidden) {
      const vw = globeEl.clientWidth;
      const vh = globeEl.clientHeight;
      const visible = entries.filter((entry) => {
        if (isOccluded(entry)) return false;
        const p = map.project(entry.lngLat);
        return p.x >= 0 && p.x <= vw && p.y >= 0 && p.y <= vh;
      });
      // Avoid featuring the same marker twice in a row when possible.
      const pool = visible.length > 1 ? visible.filter((e) => e !== autoLast) : visible;
      if (pool.length) {
        const pick = pool[Math.floor(Math.random() * pool.length)];
        autoLast = pick;
        setOpen(pick, true);
        setTimeout(() => {
          // Leave it open if the user meanwhile hovered this very marker.
          if (openEntry === pick && !pick.pill.matches(":hover")) {
            setOpen(pick, false);
          }
        }, AUTO_OPEN_MS);
      }
    }
    setTimeout(autoHoverTick, AUTO_OPEN_MS + AUTO_REST_MS);
  }

  if (!reduceMotion) setTimeout(autoHoverTick, AUTO_OPEN_MS + AUTO_REST_MS);
</script>
