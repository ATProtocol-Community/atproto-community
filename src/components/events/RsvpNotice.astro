---
import { actions, type ActionReturnType } from "astro:actions";

type RsvpResult = ActionReturnType<typeof actions.rsvpEvent>;

interface Props {
  result?: RsvpResult;
}

const { result } = Astro.props;
const status = result?.data?.status;
const eventName = result?.data?.eventName;
const errorMessage = result?.error?.message;
---

{status === "going" && (
  <p class="events-notice events-notice--success">
    {eventName ? `You're going to ${eventName}.` : "You're marked as going."}
  </p>
)}
{status === "notgoing" && (
  <p class="events-notice events-notice--success">
    {eventName ? `You're no longer going to ${eventName}.` : "You're no longer marked as going."}
  </p>
)}
{errorMessage && (
  <p class="events-notice events-notice--error">{errorMessage}</p>
)}

<style>
  .events-notice {
    margin-top: var(--space-base);
    max-width: 55ch;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .events-notice--success {
    background: var(--success-muted);
    color: var(--success-muted-foreground);
  }

  .events-notice--error {
    background: var(--error-muted);
    color: var(--error-muted-foreground);
  }
</style>
