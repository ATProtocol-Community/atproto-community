---
import { actions, type ActionReturnType } from "astro:actions";
import { getCommunityActionErrorCopy } from "../../lib/community/action-error-copy";
import { getRsvpOutcomeCopy } from "../../lib/community/rsvp-status";

type RsvpResult = ActionReturnType<typeof actions.rsvpEvent>;

interface Props {
  result?: RsvpResult;
}

const { result } = Astro.props;
const outcome = result?.data?.outcome;
const eventName = result?.data?.eventName ?? null;
const errorNotice = getCommunityActionErrorCopy(result?.error, "rsvp");
const notice = getRsvpOutcomeCopy(outcome ?? null, eventName);
---

{notice && (
  <p class={`events-notice events-notice--${notice.tone}`}>
    {notice.message}
  </p>
)}
{errorNotice && (
  <p class={`events-notice events-notice--${errorNotice.tone}`}>{errorNotice.message}</p>
)}

<style>
  .events-notice {
    margin-top: var(--space-base);
    max-width: 55ch;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .events-notice--success {
    background: var(--success-muted);
    color: var(--success-muted-foreground);
  }

  .events-notice--neutral {
    background: var(--muted);
    color: var(--foreground-secondary);
  }

  .events-notice--error {
    background: var(--error-muted);
    color: var(--error-muted-foreground);
  }
</style>
