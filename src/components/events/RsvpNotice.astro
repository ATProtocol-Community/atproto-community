---
import type { RsvpNotice as RsvpNoticeType } from "../../features/event-rsvp/notice";

interface Props {
  notice?: RsvpNoticeType | null;
}

const { notice } = Astro.props;
---

{notice && (
  <p class={`events-notice events-notice--${notice.tone}`}>
    {notice.message}
  </p>
)}

<style>
  .events-notice {
    margin-top: var(--space-base);
    max-width: 55ch;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .events-notice--success {
    background: var(--success-muted);
    color: var(--success-muted-foreground);
  }

  .events-notice--neutral {
    background: var(--muted);
    color: var(--foreground-secondary);
  }

  .events-notice--error {
    background: var(--error-muted);
    color: var(--error-muted-foreground);
  }
</style>
